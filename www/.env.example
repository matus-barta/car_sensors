# PostgreSQL database managed through SQLx migrations
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"

# Public URL of the SvelteKit application
ORIGIN="http://localhost:5173"

# Generate with:
# openssl rand -base64 32
BETTER_AUTH_SECRET=""

# OpenStreetMap Shortbread vector tiles
PUBLIC_OSM_VECTOR_TILE_URL="https://vector.openstreetmap.org/shortbread_v1/{z}/{x}/{y}.mvt"
PUBLIC_OSM_STYLE_URL="https://vector.openstreetmap.org/styles/shortbread/colorful.json"

# Optional: the same Valkey instance `ingest` uses. Enables live tracking of
# the selected vehicle; without it, the vehicle list still updates through its
# periodic poll.
# REDIS_URL="redis://localhost"