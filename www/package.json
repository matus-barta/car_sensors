{
	"name": "www",
	"version": "0.0.1",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/matus-barta/car_sensors.git",
		"directory": "www"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:prepare": "node e2e/lifecycle/database.prepare.ts",
		"test:e2e:server": "pnpm test:e2e:prepare && pnpm build && pnpm preview",
		"db:cleanup": "node ../tools/scripts/cleanup-drizzle-output.js",
		"db:pull": "drizzle-kit pull",
		"db:studio": "drizzle-kit studio",
		"db:format": "prettier --write \"src/lib/server/db/generated/*.ts\"",
		"db:sync": "pnpm db:pull && pnpm db:cleanup && pnpm auth:schema:generate && pnpm db:format",
		"db:check": "pnpm db:sync && git diff --exit-code -- src/lib/server/db/generated",
		"auth:schema:generate": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/generated/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.31.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "^1.6.23",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"better-auth": "^1.6.23",
		"drizzle-orm": "^0.45.2",
		"maplibre-gl": "^6.3.0",
		"postgres": "^3.4.9",
		"zod": "^4.4.3"
	}
}
