# One environment file for every piece of the project.
#
# `ingest` and `shared` find it by walking up from their working directory;
# `www` is pointed here by `kit.env.dir` in `www/vite.config.ts`, its Drizzle
# config and its Better Auth script. There is deliberately no second copy under
# `www/` - two files drifted apart once and left the web application reading a
# different database from the service writing to it.
#
# Copy to `.env` and fill in. The end-to-end suite is the one exception: it has
# its own committed `www/.env.test`, which Playwright loads itself.

# PostgreSQL database, managed through SQLx migrations in `db/migrations`
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"

# Valkey. Required by `ingest`. Optional for `www`, where it enables live
# tracking of the selected vehicle; without it the vehicle list still updates
# through its periodic poll.
REDIS_URL="redis://localhost"

# Where `ingest` listens
SERVER_IP_PORT="0.0.0.0:3000"

# Public URL of the SvelteKit application
ORIGIN="http://localhost:5173"

# Generate with:
# openssl rand -base64 32
BETTER_AUTH_SECRET=""

# OpenStreetMap Shortbread vector tiles
PUBLIC_OSM_VECTOR_TILE_URL="https://vector.openstreetmap.org/shortbread_v1/{z}/{x}/{y}.mvt"
PUBLIC_OSM_STYLE_URL="https://vector.openstreetmap.org/styles/shortbread/colorful.json"
