# Scoped to the Android tree on purpose. `root = true` stops the search here so
# these settings cannot reach `www/`, which is formatted by Prettier with its
# own conventions.
#
# This one file configures two things that would otherwise disagree: ktlint
# reads it, and so does Android Studio. Without it the IDE's formatter produces
# code that ktlint then rejects, which is the worst of both.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Pinned rather than left to the default, so a ktlint upgrade cannot quietly
# restyle the codebase. android_studio because it is what the IDE's own
# formatter produces, and what the code was written in before ktlint ever
# checked it - which it did not until ktlint-gradle 14, since 13 could not
# find Kotlin sources compiled by AGP 9 and checked only the build scripts.
ktlint_code_style = android_studio

# Composables are named like types by convention, which the naming rule would
# otherwise reject.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Matches the 100 columns Prettier already enforces in `www`.
max_line_length = 100

[*.{yml,yaml,json,xml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
